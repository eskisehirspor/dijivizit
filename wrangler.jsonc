{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "dijivizit",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
  "services": [
    // Self-reference binding; must match the worker name.
    { "binding": "WORKER_SELF_REFERENCE", "service": "dijivizit" },
  ],
  "env": {
    // Test deployment on dijivizit-staging.<account>.workers.dev. Production
    // traffic only moves once the custom domain is pointed at "dijivizit".
    "staging": {
      "name": "dijivizit-staging",
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "dijivizit-staging" }],
    },
  },
}
