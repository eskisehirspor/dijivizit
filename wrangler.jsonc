{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "dijivizit",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
  // Production custom domains. Cloudflare creates and owns their DNS records;
  // do not add A/CNAME records for these names by hand.
  "routes": [
    { "pattern": "app.dijivizit.com", "custom_domain": true },
    { "pattern": "dijivizit.com", "custom_domain": true },
    { "pattern": "www.dijivizit.com", "custom_domain": true },
  ],
  // Per-IP rate limits for the public forms (order request, card contact form).
  "ratelimits": [
    { "name": "FORM_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "CARD_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
  ],
  "services": [
    // Self-reference binding; must match the worker name.
    { "binding": "WORKER_SELF_REFERENCE", "service": "dijivizit" },
  ],
  "env": {
    // Test deployment on dijivizit-staging.<account>.workers.dev. Production
    // traffic only moves once the custom domain is pointed at "dijivizit".
    "staging": {
      "name": "dijivizit-staging",
      "routes": [],
      "ratelimits": [
        { "name": "FORM_LIMITER", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } },
        { "name": "CARD_LIMITER", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } },
      ],
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "dijivizit-staging" }],
    },
  },
}
